    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Premium Dark Obsidian App Icon Container -->
    <path
        android:fillColor="#0D1117"
        android:strokeColor="#1E2A36"
