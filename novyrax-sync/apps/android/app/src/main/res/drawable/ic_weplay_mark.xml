        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M 39.25,45.75 L 39.25,62.25" />

    <!-- Pillar 2 (Inner Left): Height 40dp, Center X: 48.75, Width: 5.5dp -->
    <path
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M 48.75,36.75 L 48.75,71.25">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="48.75"
                android:startY="36.75"
                android:endX="48.75"
                android:endY="71.25"
                android:type="linear">
                <item android:color="#5CE1D2" android:offset="0.0" />
                <item android:color="#21CDB8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Pillar 3 (Inner Right): Height 40dp, Center X: 58.25, Width: 5.5dp -->
    <path
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M 58.25,36.75 L 58.25,71.25">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="58.25"
                android:startY="36.75"
                android:endX="58.25"
                android:endY="71.25"
                android:type="linear">
                <item android:color="#5CE1D2" android:offset="0.0" />
                <item android:color="#21CDB8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
